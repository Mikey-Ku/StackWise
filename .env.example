# Copy to .env.local (gitignored) and fill in. Everything works without these; AI steps fall back.

# Turns on the AI pre-fill, plan explanations, the evals and the source checker. Claude is the default.
ANTHROPIC_API_KEY=

# Optional: OpenAI or Gemini as the built-in AI instead, picked in Connect or the Ask panel.
OPENAI_API_KEY=
GEMINI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# GEMINI_MODEL=gemini-3.8-flash

# More models. Each turns on once its key (if it needs one) and its model are set.
# OPENROUTER_API_KEY=  OPENROUTER_MODEL=
# GROQ_API_KEY=        GROQ_MODEL=
# MISTRAL_API_KEY=     MISTRAL_MODEL=
# OLLAMA_MODEL=        OLLAMA_BASE_URL=http://localhost:11434/v1
# Any other API that speaks OpenAI's chat format:
# CUSTOM_AI_BASE_URL=  CUSTOM_AI_API_KEY=  CUSTOM_AI_MODEL=  CUSTOM_AI_LABEL=

# Optional overrides.
# WHYSTACK_MODEL=claude-opus-5
# WHYSTACK_EFFORT=low
# WHYSTACK_AI_LIMIT_PER_HOUR=30
# WHYSTACK_AI=off
# Pairing with a coding agent: how long one wait_for_message call waits (max 240 seconds), and
# how many quiet minutes before the agent stops listening.
# WHYSTACK_PAIR_WAIT_S=240
# WHYSTACK_PAIR_IDLE_MIN=30

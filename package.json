{
  "name": "stackwise",
  "version": "0.1.0",
  "private": true,
  "description": "Plan a web app stack you understand: a sourced rules engine checks every connection, then hands your AI builder a spec.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4310",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4310",
    "lint": "eslint",
    "mcp": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:data": "vitest run src/engine/data.test.ts",
    "check:options": "tsx scripts/check-options.ts",
    "eval:prefill": "tsx --env-file-if-exists=.env.local scripts/eval-prefill.ts",
    "eval:plain-llm": "tsx --env-file-if-exists=.env.local scripts/eval-plain-llm.ts",
    "eval:questions": "tsx scripts/eval-questions.ts",
    "check:sources": "tsx --env-file-if-exists=.env.local scripts/check-sources.ts",
    "draft:option": "tsx --env-file-if-exists=.env.local scripts/draft-option.ts",
    "build:logos": "tsx scripts/build-logos.ts",
    "stackwise": "tsx scripts/stackwise.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.0",
    "fflate": "^0.8.3",
    "html-to-image": "1.11.11",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "simple-icons": "^16.31.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4",
  "bin": {
    "stackwise": "bin/stackwise"
  }
}
